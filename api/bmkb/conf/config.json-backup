{
	"server":"dev"
	,"moduleversion":"0.0.0"
	,"datarelease":"2.0.2"
	,"session_life":24.0
	,"max_batch_size":100
	,"supersearch_batch_size":300000
	,"max_global_search_results":1000000
	,"max_query_value_len":10000
	,"max_sequence_len":3000
	,"max_download_records":100000
	,"cache_batch_size":5000
	,"globalsearchcutoff":1.0
	,"max_results_count":{
		"glycan":100000
		,"protein":100000
	}
	,"admin_list":[
		"rykahsay@gwu.edu"
	]
	,"jobinfo":{
		"tspath":"/usr/local/bin/ts",
		"maxjobs":5,
		"structure_search":{
             
			"incmdflag":"-i",
                
			"outcmdflag":"-o",
                
			"urlcmdflag":"-u",
			"apiurl":{
                    
				"prd":"http://172.17.0.12:10980",
                    
				"beta":"http://172.17.0.13:10990",
                    
				"tst":"http://172.17.0.4:10980",
                    "dev":"http://172.17.0.4:10980"
                },
		"path":{
                    "prd":"python /app/job_submitters/structure_search.py",
                    "beta":"python /app/job_submitters/structure_search.py",
                    "tst":"python /app/job_submitters/structure_search.py",
                    "dev":"python /app/job_submitters/structure_search.py"
                },
                "input_files":[
                    {"name":"input.json", "format":"json"}
                ],
                "output_files":[
                    {"name":"output.json", "format":"json"}
                ],
                "paramlist":[
                    {"id":"seq", "label":"Sequence", "type":"str", "value":"xxx"},
                    {"id":"align","label":"Align", "type":"str", "value":"core"}
                ]
            },            
            "blastp":{
                "incmdflag":"-query",
                "outcmdflag":"-out",
                "max_input_records":10,
                "path":{
                    "prd":"python /app/job_submitters/blastp.py",
                    "beta":"python /app/job_submitters/blastp.py",
                    "tst":"python /app/job_submitters/blastp.py",
                    "dev":"python /app/job_submitters/blastp.py"
                },
                "input_files":[
                    {"name":"input.fasta", "format":"fasta"}
                ],
                "output_files":[
                    {"name":"output.blastout", "format":"blastout"}
                ],
                "paramlist":[
                    {"id":"seq", "label":"Sequence", "type":"str", "value":"xxx"},
                    {
                        "id":"targetdb", "label":"Target DB", "type":"str",
                        "cmdflag":"-db",
                        "optlist":[
                        ]
                    },
                    {
                        "id":"evalue", "label":"E-value", "type":"float", "value":1e-3,
                        "cmdflag":"-evalue"
                    },
                    {
                        "id":"num_alignments", "label":"Max number of hits (Proteins)", "type":"int", "value":250, "cmdflag":"-num_alignments"
                    }
                ]
            },
	    "isoform_mapper":{
                "incmdflag":"-i",
		"max_input_records":10,
                "path":{
                    "prd":"python /app/job_submitters/isoform_mapper.py",
                    "beta":"python /app/job_submitters/isoform_mapper.py",
                    "tst":"python /app/job_submitters/isoform_mapper.py",
                    "dev":"python /app/job_submitters/isoform_mapper.py"
                },
		"input_files":[
                    {"name":"input.csv", "format":"csv"}
                ],
		"output_files":[
                    {"name":"output.tsv", "format":"tsv"}
                ],
		"paramlist":[]
	    }
        }
        ,"record_type_info":{
            "protein":{"field":"uniprot_canonical_ac", "label":"UniProtKB Canonical Ac", "concept_label":"Protein"}
            ,"enzyme":{"field":"uniprot_canonical_ac", "label":"UniProtKB Canonical Ac", "concept_label":"Enzyme"}
            ,"gene":{"field":"uniprot_canonical_ac", "label":"UniProtKB Canonical Ac", "concept_label":"Gene"}
            ,"glycan":{"field":"glytoucan_ac","label":"GlyTouCan Ac", "concept_label":"Glycan"}
            ,"motif":{"field":"motif_ac", "label":"Motif Ac", "concept_label":"Motif"}
            ,"disease":{"field":"record_id", "label":"Disease ID", "concept_label":"Disease"}
            ,"species":{"field":"taxid", "label":"Tax ID", "concept_label":"Organism"}
            ,"site":{"field":"id", "label":"Site ID", "concept_label":"Site"}
        }
        ,"projectedfieldsglobalsearch":{
            "c_glycan":{
                "glytoucan_ac":1
            }
            ,"c_protein":{
                "uniprot_canonical_ac":1
            }
