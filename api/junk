30%. The area under ROC curve was 0.846 for AFP."}],"tags":[{"tag":"assessed_biomarker_entity"},{"tag":"best_biomarker_role"},{"tag":"biomarker"},{"tag":"condition"},{"tag":"specimen"}]}],"specimen":[{"id":"UBERON:0000178","name":"blood","loinc_code":"","name_space":"UBERON","url":"http://purl.obolibrary.org/obo/UBERON_0000178","loince_code_url":""}]}]}],"class":1,"recommended_name":"mRNA-decapping enzyme 1A","synonyms":[{"synonym":"3.6.1.62"},{"synonym":"Smad4-interacting transcriptional co-activator"},{"synonym":"Transcription factor SMIF"},{"synonym":"mRNA-decapping enzyme 1A isoform b"},{"synonym":"transcription factor SMIF"},{"synonym":"Smad4-interacting transcriptional co-activator"},{"synonym":"mRNA-decapping enzyme 1A"},{"synonym":"decapping enzyme hDcp1a"},{"synonym":"putative protein product of Nbla00360"},{"synonym":"DCP1 decapping enzyme homolog A"},{"synonym":"DCP1 decapping enzyme-like protein A"}]},{"hgnc_id":"HGNC:1160","ref_id":"UPKB:Q96RR1","entities":[{"entity_type":"protein","entity_id":"UPKB:Q96RR1","orig_entity_id":"UPKB:Q96RR1","entity_normal_ranges":[],"annotations":[{"entity_id":"UPKB:Q96RR1","annotation_category":"protein_function","annotation_term":"Mitochondrial helicase involved in mtDNA replication and repair (PubMed:12975372, PubMed:15167897, PubMed:17324440, PubMed:18039713, PubMed:18971204, PubMed:25824949, PubMed:26887820, PubMed:27226550). Might have a role in mtDNA repair (PubMed:27226550). Has DNA strand separation activity needed to form a processive replication fork for leading strand synthesis which is catalyzed by the formation of a replisome complex with POLG and mtSDB (PubMed:12975372, PubMed:15167897, PubMed:18039713, PubMed:22383523, PubMed:26887820, PubMed:27226550). Preferentially unwinds DNA substrates with pre-existing 5'-and 3'- single-stranded tails but is also active on a 5'- flap substrate (PubMed:12975372, PubMed:15167897, PubMed:18039713, PubMed:22383523, PubMed:26887820, PubMed:27226550). Can dissociate the invading strand of immobile or mobile D-loop DNA structures irrespective of the single strand polarity of the third strand (PubMed:27226550). In addition to its DNA strand separation activity, also has DNA strand annealing, DNA strand-exchange and DNA branch migration activities (PubMed:22383523, PubMed:26887820, PubMed:27226550).","evidence":[{"id":"Q96RR1","database":"","url":""},{"id":"15167897","database":"","url":""},{"id":"18039713","database":"","url":""},{"id":"22383523","database":"","url":""},{"id":"25824949","database":"","url":""},{"id":"18971204","database":"","url":""},{"id":"17324440","database":"","url":""},{"id":"26887820","database":"","url":""},{"id":"27226550","database":"","url":""},{"id":"12975372","database":"","url":""}]},{"entity_id":"UPKB:Q96RR1","annotation_category":"protein_function","annotation_term":"Lack DNA unwinding and ATP hydrolysis activities (PubMed:18039713). Does not bind single-stranded or double-stranded DNA (PubMed:18039713).","evidence":[{"id":"Q96RR1","database":"","url":""},{"id":"18039713","database":"","url":""}]}],"crossref":[{"id":"Q96RR1","url":"https://hivelab.biochemistry.gwu.edu/biomuta/proteinview/Q96RR1","database":"BioMuta","categories":[]},{"id":"Q96RR1","url":"https://glygen.org/protein/Q96RR1","database":"GlyGen","categories":[]},{"id":"Q96RR1","url":"https://www.uniprot.org/uniprotkb/Q96RR1/entry","database":"UniProtKB","categories":[]},{"id":"17174-4","url":"https://loinc.org/17174-4","database":"LOINC","categories":[]}],"citation":[{"title":"Identification and validation of HELLS (Helicase, Lymphoid-Specific) and ICAM1 (Intercellular adhesion molecule 1) as potential diagnostic biomarkers of lung cancer.","journal":"PeerJ","date":"2020","authors":"Zhu Wei, Li Lin Lin, Songyang Yiyan, Shi Zhan, Li Dejia","reference":[{"id":"32195055","type":"PubMed","url":"https://pubmed.ncbi.nlm.nih.gov/32195055"}],"evidence":[]}],"biomarkers":[{"biomarker_id":"AN6467-1","condition":{"id":"DOID:1324","recommended_name":{"id