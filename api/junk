RC1 complex (PubMed:28489822). Required for normal antibody isotype switching from IgM to IgG (By similarity).","evidence":[{"id":"Q12933","database":"","url":""},{"id":"23453969","database":"","url":""},{"id":"19810754","database":"","url":""},{"id":"10346818","database":"","url":""},{"id":"19150425","database":"","url":""},{"id":"19937093","database":"","url":""},{"id":"11907583","database":"","url":""},{"id":"19918265","database":"","url":""},{"id":"20064526","database":"","url":""},{"id":"12917689","database":"","url":""},{"id":"20385093","database":"","url":""},{"id":"20047764","database":"","url":""},{"id":"20577214","database":"","url":""},{"id":"22212761","database":"","url":""},{"id":"11784851","database":"","url":""},{"id":"15121867","database":"","url":""},{"id":"19506082","database":"","url":""},{"id":"15383523","database":"","url":""},{"id":"18981220","database":"","url":""},{"id":"28489822","database":"","url":""}]}],"crossref":[{"id":"Q12933","url":"https://hivelab.biochemistry.gwu.edu/biomuta/proteinview/Q12933","database":"BioMuta","categories":[]},{"id":"Q12933","url":"https://glygen.org/protein/Q12933","database":"GlyGen","categories":[]},{"id":"Q12933","url":"https://www.uniprot.org/uniprotkb/Q12933/entry","database":"UniProtKB","categories":[]}],"citation":[{"title":"TRAF2 is a Valuable Prognostic Biomarker in Patients with Prostate Cancer.","journal":"Medical science monitor : international medical journal of experimental and clinical research","date":"2017-08-31","authors":"Wei Bingbing, Liang Jiabei, Hu Jimeng, Mi Yuanyuan, Ruan Jun, Zhang Jian, Wang Zhirong, Hu Qiang, Jiang Haowen, Ding Qiang","reference":[{"id":"28855498","type":"PubMed","url":"https://pubmed.ncbi.nlm.nih.gov/28855498"}],"evidence":[]}],"biomarkers":[{"biomarker_id":"AN6497-1","condition":{"id":"DOID:10283","recommended_name":{"id":"DOID:10283","name":"prostate cancer","description":"A male reproductive organ cancer that is located_in the prostate.","resource":"Disease Onto